# Copy this file to .env and fill in only the values you need.
# Never commit .env, WhatsApp sessions, API keys, cookies, or auth files.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
BOT_PREFIX=.
PORT=3001

# Reply to commands sent by the linked account and/or other people.
HANDLE_SELF_MESSAGES=true
HANDLE_INCOMING_MESSAGES=true

# Owner info shown by commands such as .owner and .bot.
# Use international format without spaces. AUTH_PHONE_NUMBER is for pairing-code login.
OWNER_NUMBER=
AUTH_PHONE_NUMBER=
OWNER_NAME=Owner

# Public URL for this backend. Used in status text and provider headers.
DASHBOARD_URL=http://localhost:3001

# Protects the private auth page and auth API routes.
# Open /auth?token=YOUR_TOKEN after setting this.
DASHBOARD_AUTH_TOKEN=

# Optional public text/links shown by commands and the public status page.
SCRIPT_URL=
DONATE_TEXT=
RULES_TEXT=

# Optional forced perfect-match names for compatibility/ship commands.
PERFECT_MATCH_NAME_1=
PERFECT_MATCH_NAME_2=

# ---------------------------------------------------------------------------
# AI chat provider
# ---------------------------------------------------------------------------
# OpenAI-compatible chat endpoint by default.
# Examples:
#   OpenAI:       AI_API_BASE_URL=https://api.openai.com/v1
#   Gemini:       AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   Puter.js:     AI_API_BASE_URL=puter
#   Pollinations: AI_API_BASE_URL=https://gen.pollinations.ai/v1
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Let the AI call safe bot tools such as run_bot_command, generate_image, etc.
AI_ENABLE_TOOLS=true

# Logs provider request/response details for debugging. Keep false in public logs.
AI_DEBUG=false

# ---------------------------------------------------------------------------
# AI image generation
# ---------------------------------------------------------------------------
# Leave blank to reuse AI_API_BASE_URL and AI_API_KEY.
# Examples:
#   OpenAI-compatible: AI_IMAGE_ENDPOINT=/images/generations
#   Gemini native:     AI_IMAGE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   Cloudflare AI:     AI_IMAGE_API_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run
#   Puter.js:          AI_IMAGE_API_BASE_URL=puter
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_IMAGE_ENDPOINT=/images/generations

# ---------------------------------------------------------------------------
# AI text-to-speech and speech-to-text
# ---------------------------------------------------------------------------
# Leave base URL/key blank to reuse the chat provider when compatible.
AI_TTS_API_BASE_URL=
AI_TTS_API_KEY=
AI_TTS_MODEL=
AI_TTS_VOICE=alloy

AI_STT_MODEL=
AI_STT_LANGUAGE=
AI_STT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# AI embeddings
# ---------------------------------------------------------------------------
# Used only when the user explicitly asks for embeddings/vectors/similarity.
AI_EMBEDDING_API_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_ENDPOINT=/embeddings

# ---------------------------------------------------------------------------
# Puter.js provider
# ---------------------------------------------------------------------------
# Set AI_API_BASE_URL=puter, AI_IMAGE_API_BASE_URL=puter, or AI_TTS_API_BASE_URL=puter
# to use Puter for that feature. Model lists can use commas or pipes for fallback:
# PUTER_CHAT_MODEL=model1,model2|model3
PUTER_AUTH_TOKEN=
PUTER_CHAT_MODEL=gpt-5-nano
PUTER_IMAGE_MODEL=
PUTER_TTS_MODEL=
PUTER_TTS_VOICE=
PUTER_STT_MODEL=
PUTER_TIMEOUT_MS=60000
PUTER_RETRIES=1

# ---------------------------------------------------------------------------
# AI memory
# ---------------------------------------------------------------------------
# Stores lightweight chat context and contact names for AI recall.
# If AI_MEMORY_FILE is blank, the file is created under SESSION_PATH.
AI_MEMORY_ENABLED=true
AI_MEMORY_FILE=
AI_MEMORY_MAX_MESSAGES=80
AI_MEMORY_MAX_MB=5
AI_MEMORY_OVERFLOW_MODE=compact
AI_MEMORY_MAX_TEXT_CHARS=1000

# ---------------------------------------------------------------------------
# Deleted-message recovery
# ---------------------------------------------------------------------------
# Stores metadata for recent messages so .deleted can show deleted content.
# Media recovery works only when the bot cached a decryptable payload before deletion.
DELETED_MESSAGE_RECOVERY_ENABLED=true
DELETED_MESSAGE_FILE=
DELETED_MESSAGE_MAX_MESSAGES=500
DELETED_MESSAGE_MAX_DELETED=100
DELETED_MESSAGE_MAX_TEXT_CHARS=4000
DELETED_MESSAGE_DEBUG=false

# Media recovery stores images/audio/video locally by default.
# DELETED_MESSAGE_MEDIA_MAX_MB is the max size for one recovered media file.
# DELETED_MESSAGE_MEDIA_MAX_TOTAL_MB is the local cleanup cap for all recovered media.
DELETED_MESSAGE_MEDIA_ENABLED=true
DELETED_MESSAGE_MEDIA_DIR=
DELETED_MESSAGE_MEDIA_MAX_MB=25
DELETED_MESSAGE_MEDIA_STORAGE=local
DELETED_MESSAGE_MEDIA_MAX_TOTAL_MB=1024

# Set DELETED_MESSAGE_MEDIA_STORAGE=mega to upload recovered media to MEGA.
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER_PATH=whatsapp-halfbot/deleted-media
MEGA_2FA_CODE=

# ---------------------------------------------------------------------------
# Optional provider compatibility
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=alloy

# Spotify is used for search/metadata. Downloadable audio still comes from yt-dlp sources.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=

# ---------------------------------------------------------------------------
# WhatsApp message filtering and persistence
# ---------------------------------------------------------------------------
IGNORE_NEWSLETTER_MESSAGES=true
IGNORE_OLD_MESSAGES_SECONDS=0
STARTUP_IGNORE_MESSAGES_SECONDS=20
SESSION_PATH=./sessions

# ---------------------------------------------------------------------------
# yt-dlp / media download helpers
# ---------------------------------------------------------------------------
# Leave YT_DLP_PATH blank to use yt-dlp from PATH.
YT_DLP_PATH=
YT_DLP_COOKIES_PATH=
YT_DLP_JS_RUNTIME=
YT_DLP_REMOTE_COMPONENTS=

# ---------------------------------------------------------------------------
# Panel/VPS startup script
# ---------------------------------------------------------------------------
# Used by scripts/lunafy-start.js and start.js.
AUTO_GIT_PULL=true
GIT_REMOTE=origin
GIT_BRANCH=master
AUTO_NPM_INSTALL=true
AUTO_PRISMA_GENERATE=true
AUTO_BUILD=true
BOT_ENTRY=dist/index.js

# Some panels provide SERVER_PORT automatically. If present, the startup script
# uses SERVER_PORT instead of PORT.
# SERVER_PORT=

# ---------------------------------------------------------------------------
# Redis and database
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

DATABASE_URL="postgresql://user:password@localhost:5432/whatsapp_bot?schema=public"
